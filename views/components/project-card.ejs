<article class="project-card">
  <div class="project-copy">
    <% if (typeof headingLevel !== 'undefined' && headingLevel === 2) { %><h2><%= title %></h2><% } else { %><h3><%= title %></h3><% } %>
    <p><%= description %></p>
  </div>
  <div class="project-actions">
    <% buttons.forEach(button => { %>
      <% const label = button.text || (button.icon === 'github' ? 'View on GitHub' : button.icon === 'gitlab' ? 'View on GitLab' : 'View project'); %>
      <a class="text-link" href="<%= button.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= label %>: <%= title %> (opens in a new tab)"><%= label %></a>
    <% }); %>
  </div>
</article>
