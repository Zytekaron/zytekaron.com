<section class="page-heading">
  <div class="page-intro"><%- content %></div>
</section>
<section class="all-projects" aria-label="Projects">
  <div class="project-list">
    <% projects.forEach((project, index) => { %><%- include('components/project-card', { ...project, index, headingLevel: 2 }) %><% }); %>
    <% if (!projects.length) { %><p class="empty-state">More projects are on the way. In the meantime, you can find my code on <a href="https://github.com/Zytekaron">GitHub</a>.</p><% } %>
  </div>
  <a class="text-link projects-github" href="https://github.com/Zytekaron" target="_blank" rel="noopener noreferrer">More on GitHub<span class="sr-only"> (opens in a new tab)</span></a>
</section>
