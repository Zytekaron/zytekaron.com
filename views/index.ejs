<section class="home-intro" aria-labelledby="home-title">
  <div class="intro-copy" id="home-title">
    <p class="intro-label">Software developer · Seattle, WA</p>
    <%- content %>
    <div class="intro-links">
      <a class="button button-primary" href="/projects">View projects</a>
      <a class="button button-secondary" href="/about">About me</a>
    </div>
  </div>
  <aside class="home-profile" aria-label="Profile">
    <img src="<%= global.pages.about.image %>" alt="Zytekaron's personal avatar" width="72" height="72" />
    <p class="profile-name">Zytekaron</p>
    <p class="profile-location">Seattle, Washington</p>
    <div class="profile-contact">
      <% global.socials.filter(social => ['Email', 'GitHub'].includes(social.name)).forEach(social => { %>
        <a href="<%= social.href %>"<% if (social.name !== 'Email') { %> target="_blank" rel="noopener noreferrer"<% } %>><%= social.name %><% if (social.name !== 'Email') { %><span class="sr-only"> (opens in a new tab)</span><% } %></a>
      <% }); %>
    </div>
  </aside>
</section>
<section class="home-section" aria-labelledby="selected-work">
  <div class="section-heading"><h2 id="selected-work">Selected projects</h2><a class="text-link" href="/projects">All projects</a></div>
  <div class="project-list">
    <% projects.forEach((project, index) => { %><%- include('components/project-card', { ...project, index }) %><% }); %>
  </div>
</section>
<section class="home-section interests-section" aria-labelledby="interests-heading">
  <div class="section-heading"><h2 id="interests-heading">What I'm interested in</h2></div>
  <dl class="interest-list">
    <div><dt>Working with</dt><dd>Go and Node.js</dd></div>
    <div><dt>Learning</dt><dd>C and C++</dd></div>
    <div><dt>Exploring</dt><dd>Security, cryptography, and online privacy</dd></div>
  </dl>
</section>
